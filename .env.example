# Application
APP_NAME=KnowledgeOps RAG Platform
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://knowledgeops:knowledgeops@localhost:15432/knowledgeops

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledgeops_chunks

# Providers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_PROVIDER=mock
RERANKING_PROVIDER=local
EVALUATION_PROVIDER=local

# Optional commercial providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Ingestion
DEMO_KNOWLEDGE_PATH=demo_knowledge
INGESTION_CONFIG_PATH=config/ingestion.yaml
RETRIEVAL_CONFIG_PATH=config/retrieval.yaml

# Demo user group for access control simulation
DEFAULT_USER_GROUP=ENGINEERING

# Pricing (optional cost tracking)
EMBEDDING_COST_PER_1K_TOKENS=0.0
GENERATION_INPUT_COST_PER_1K_TOKENS=0.0
GENERATION_OUTPUT_COST_PER_1K_TOKENS=0.0
